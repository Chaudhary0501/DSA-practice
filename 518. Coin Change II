class Solution {
    public int change(int amount, int[] coins) {
        int[][] dp = new int[coins.length + 1][amount + 1];
        for(int[] a : dp){
            Arrays.fill(a, -1);
        }
        return No_Of_Ways(coins, amount, 0, dp);
    }
    public int No_Of_Ways(int[] coins, int amount, int i, int[][] dp){
        if(amount == 0){
            return 1;
        }
        if(i == coins.length){
            return 0;
        }
        if(dp[i][amount] != -1){
            return dp[i][amount];
        }
        int inc = 0;
        int exc = 0;
        if(amount >= coins[i]){
            inc = No_Of_Ways(coins, amount - coins[i], i, dp);
        }
        exc = No_Of_Ways(coins, amount, i + 1, dp);
        return dp[i][amount] = inc + exc;
    }
}
