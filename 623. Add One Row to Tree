/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public TreeNode addOneRow(TreeNode root, int val, int depth) {
        if(depth == 1){
            TreeNode node = new TreeNode(val);
            node.left = root;
            root = node; 
            return root;
        }
        row(root, val, depth, 1);
        return root;
    }
    public void row(TreeNode root, int val, int depth, int currDepth){
        if(root == null){
            return ;
        }
        if(currDepth == depth - 1){
            TreeNode left_node = root.left;
            root.left = new TreeNode(val);
            root.left.left = left_node;
           
            TreeNode right_node = root.right;
            root.right = new TreeNode(val);
            root.right.right = right_node;
            return;
        }
        row(root.left, val, depth, currDepth + 1);
        row(root.right, val, depth, currDepth + 1);
    }
}
