class Solution {
    public int minFallingPathSum(int[][] matrix) {
        int[][] dp = new int[matrix.length][matrix[0].length];
        for(int[] a : dp){
            Arrays.fill(a, -1000);
        }
        int min = Integer.MAX_VALUE;
        for(int i = 0; i < matrix[0].length; i++){
            min = Math.min(min, minSum(matrix, 0, i, dp));
        }
        return min;
    }
    public int minSum(int[][] matrix, int row, int col, int[][] dp){
        if(col < 0 || col >= matrix[0].length){
            return Integer.MAX_VALUE;
        }
        if(row == matrix.length - 1 ){
            return matrix[row][col];
        }
        if(dp[row][col] != -1000){
            return dp[row][col];
        }
        int dia_left = minSum(matrix, row + 1, col - 1, dp);
        int down = minSum(matrix, row + 1, col, dp);
        int dia_right = minSum(matrix, row + 1, col + 1, dp);
        return dp[row][col] = Math.min(dia_left, Math.min(down, dia_right)) + matrix[row][col];
    }
}
