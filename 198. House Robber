    public int robbery(int[] nums, int i, int[] dp){
        if(i >= nums.length){
            return 0;
        }
        if(dp[i] != -1){
            return dp[i];
        }
        int rob = nums[i] + robbery(nums, i + 2, dp);      //dp[i + 2]
        int Dn_rob = robbery(nums, i + 1, dp);           //dp[i + 1];
        return dp[i] = Math.max(rob, Dn_rob);          //dp[i]
    }
}
