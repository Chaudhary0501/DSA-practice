            }
        }
        for(int i = 0; i < str2.length; i++){
            if(map.containsKey(str2[i]) && map.get(str2[i])>0){
                map.put(str2[i], map.get(str2[i])-1);
            }else if(map.containsKey(str2[i]) && map.get(str2[i])==0){
