class Solution {
    // logn for one insertion, nlogn for n insertions
    // logn for one deletion, klogn for k deletions
    // time complexity = nlogn + klogn, space = O(N)
    // UPPER for BRUTE FORCE i.e. cerate full heap and then deletion

    // for OPTIMIZED, time = nlogk , time = O(K)
    // create heap of k elements, element at top is Kth largest. If next element is greater than Kth largest, remove Kth largest and Kth largest = new

    public int findKthLargest(int[] nums, int k) {
        PriorityQueue<Integer> pq = new PriorityQueue<>();
        for(int i = 0; i < k; i++){
            pq.add(nums[i]);
        }
        for(int i = k; i < nums.length; i++){
            if(nums[i] > pq.peek()){
                pq.poll();
                pq.add(nums[i]);
            }
        }
        return pq.peek();
    }
}
