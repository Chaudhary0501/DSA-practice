/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public List<List<Integer>> pathSum(TreeNode root, int targetSum) {
        ArrayList<Integer> ll = new ArrayList<>();
        List<List<Integer>> ans = new ArrayList<>();
        sum(root, targetSum, ll, ans);
        return ans;
    }
    public void sum(TreeNode root, int targetSum, ArrayList<Integer> ll, List<List<Integer>> ans){
        if(root == null){
            return;
        }
        ll.add(root.val);
        if(root.left == null && root.right == null){
            if(targetSum - root.val == 0){
                ans.add(new ArrayList<Integer>(ll));
                ll.remove(ll.size() - 1);
                return;
            }else{
                ll.remove(ll.size() - 1);
                return;
            }
        }
        sum(root.left, targetSum - root.val, ll, ans);
        sum(root.right, targetSum - root.val, ll, ans);
        ll.remove(ll.size() - 1);
    }
}
