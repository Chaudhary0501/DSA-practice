        //     }
        // }
        // return max;
        //-----------------------------------------------------------------------------------

        //to be in hashmap, check before adding if (num-1) exists, if not (num = true) else false.
        //after adding, check if (num+1) exists, and make it false if true.

        HashMap<Integer, Boolean> map = new HashMap<>();
        for(int i = 0; i < nums.length; i++){
            if(map.containsKey(nums[i]-1)){
                map.put(nums[i], false);
            }else{
                map.put(nums[i], true);
            }
            if(map.containsKey(nums[i]+1)){
                map.put(nums[i]+1, false);
            }
        }
        int ans = 0;
        for(int key : map.keySet()){
            if(map.get(key)){
                int count = 0;
                while(map.containsKey(key)){      //O(n) as while loop runs only once for any element.
                    count++;
                    key++;
                }
                ans = Math.max(ans, count);
            }
        }
        return ans;
    }
}
