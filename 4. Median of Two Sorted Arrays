class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int[] arr = new int[nums1.length  + nums2.length];
        int i = 0;
        int j = 0;
        int k = 0;
        while(i < nums1.length && j < nums2.length){
            if(nums1[i] < nums2[j]){
                arr[k] = nums1[i];
                i++;
                k++;
            }else{
                arr[k] = nums2[j];
                j++;
                k++;
            }
        }
        if(i == nums1.length){
            while(j < nums2.length){
                arr[k] = nums2[j];
                j++;
                k++;
            }
        }
        if(j == nums2.length){
            while(i < nums1.length){
                arr[k] = nums1[i];
                i++;
                k++;
            }
        }
        int len = arr.length;
        double median;
        if(len % 2 == 0){
            median = (((double)(arr[len/2]) + (double)(arr[(len/2) - 1])) / 2);
        }else{
            median = arr[len/2];
        }
        return median;
    }
}
