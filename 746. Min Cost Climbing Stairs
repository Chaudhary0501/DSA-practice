class Solution {
    public int minCostClimbingStairs(int[] cost) {
        int[] dp = new int[cost.length];
        Arrays.fill(dp, -1);
        int zero = Min_CostTD(cost, 0, dp);
        int one = Min_CostTD(cost, 1, dp);
        return Math.min(zero, one);
    }
    public int Min_CostTD(int[] cost, int i, int[] dp){
        if(i >= cost.length){
            return 0;
        }
        if(dp[i] != -1){
            return dp[i];
        }
        int first = Min_CostTD(cost, i + 1, dp);
        int second = Min_CostTD(cost, i + 2, dp);
        return dp[i] = Math.min(first, second) + cost[i];
    }
}
