class Solution {
    public int waysToSplitArray(int[] nums) {
        
        long sum = 0, total_sum = 0;
        int count = 0;

        for(int i = 0; i < nums.length; i++){
            total_sum += nums[i];
        }

        for(int i = 0; i < nums.length - 1; i++){
            sum = sum + nums[i];
            if(sum >= (total_sum - sum)){
                count++;
            }
        }
        
        return count;
    }
}
